<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LankaLens.AdministrativeDivisions</RootNamespace>
    <AssemblyName>LankaLens.AdministrativeDivisions</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <VersionPrefix>0.1.0</VersionPrefix>
    <PackageId>LankaLens.AdministrativeDivisions</PackageId>
    <Title>LankaLens Administrative Divisions</Title>
    <Authors>Poorna Soysa</Authors>
    <Description>
      Sri Lanka administrative divisions for .NET, including provinces,
      districts, divisional secretariats, and Grama Niladhari divisions
      with English names and authoritative Sinhala/Tamil names when available.
    </Description>
    <PackageTags>sri-lanka;administrative-divisions;province;district;divisional-secretariat;grama-niladhari</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(RepoRoot)artifacts/packages/</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <!-- RepositoryUrl intentionally omitted until a real public GitHub URL is available. -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\administrative-divisions.json">
      <LogicalName>LankaLens.AdministrativeDivisions.Data.administrative-divisions.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LankaLens.AdministrativeDivisions.Tests" />
  </ItemGroup>

</Project>
