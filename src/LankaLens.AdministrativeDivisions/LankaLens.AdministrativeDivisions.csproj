<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LankaLens.AdministrativeDivisions</RootNamespace>
    <AssemblyName>LankaLens.AdministrativeDivisions</AssemblyName>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn)</NoWarn>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>preview.2</VersionSuffix>
    <PackageId>LankaLens.AdministrativeDivisions</PackageId>
    <Title>LankaLens Administrative Divisions</Title>
    <Authors>Poorna Soysa</Authors>
    <Copyright>Copyright (c) 2026 Poorna Soysa</Copyright>
    <Description>
      Sri Lanka administrative divisions for .NET, including provinces,
      districts, divisional secretariats, and Grama Niladhari divisions
      with English names and authoritative Sinhala/Tamil names when available.
    </Description>
    <PackageTags>sri-lanka;administrative-divisions;province;district;divisional-secretariat;grama-niladhari;sinhala;tamil</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/poorna-soysa/LankaLens</PackageProjectUrl>
    <RepositoryUrl>https://github.com/poorna-soysa/LankaLens</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageReleaseNotes>
  LankaLens.AdministrativeDivisions 0.1.0-preview.2

  Changes in this preview:
  - Added the official LankaLens NuGet package icon.
  - Improved NuGet package metadata and presentation.
  - Kept Poorna Soysa as the package author.
  - No breaking changes to the public API.
  - No changes to the administrative hierarchy or bundled dataset.

  Bundled administrative snapshot:
  - 9 Provinces
  - 25 Districts
  - 340 Divisional Secretariat Divisions
  - 14,008 Grama Niladhari Divisions
  - Complete English names
  - Sinhala and Tamil names for all Provinces, Districts, and Divisional Secretariat Divisions
  - Sinhala and Tamil names for 13,723 of 14,008 Grama Niladhari Divisions

  Unverified Sinhala/Tamil GN names remain null rather than being machine-generated.

  The package continues to provide offline hierarchy navigation, code-based lookups, and multilingual search with no database or network dependency.

  This is a prerelease version and the public API may still evolve before 1.0.0.
</PackageReleaseNotes>
    <PackageOutputPath>$(RepoRoot)artifacts/packages/</PackageOutputPath>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Baseline is optional until eng/api-compat package is committed after first pack. -->
  <PropertyGroup Condition="Exists('$(RepoRoot)eng/api-compat/LankaLens.AdministrativeDivisions.0.1.0-preview.1.nupkg')">
    <PackageValidationBaselinePath>$(RepoRoot)eng/api-compat/LankaLens.AdministrativeDivisions.0.1.0-preview.1.nupkg</PackageValidationBaselinePath>
  </PropertyGroup>

 <ItemGroup>
  <None Include="README.md" Pack="true" PackagePath="\" />
  <None Include="..\..\DATA-NOTICE.md" Pack="true" PackagePath="\" />
  <None Include="$(RepoRoot)assets\icon.png" Pack="true" PackagePath="\" />
</ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\administrative-divisions.json">
      <LogicalName>LankaLens.AdministrativeDivisions.Data.administrative-divisions.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LankaLens.AdministrativeDivisions.Tests" />
  </ItemGroup>

</Project>
